---
import Basis from '../../layouts/Basis.astro';
import { getCollection, render, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const essays = await getCollection('essays');
  return essays.map((essay) => ({
    params: { slug: essay.id },
    props: { essay },
  }));
}

const { essay } = Astro.props;
const { Content } = await render(essay);

const datum = essay.data.date.toLocaleDateString('de-DE', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});

const feldEntry = await getEntry('felder', essay.data.feld);
const feld = feldEntry ? { name: feldEntry.data.title } : null;

// 200 Wörter/Minute, aufgerundet, mindestens 1
const woerter = (essay.body ?? '').split(/\s+/).filter(Boolean).length;
const lesezeit = Math.max(1, Math.round(woerter / 200));
---

<Basis titel={`${essay.data.title} — annotanda`} leserModus={true}>
  <div class="fortschritt" aria-hidden="true"></div>
  <article>
    <a href="/essays/" class="zurueck">← Essays</a>
    {essay.data.bild && (
      <figure class="kopfbild">
        <img src={essay.data.bild} alt={essay.data.bild_untertitel ?? essay.data.title} loading="eager" />
        {essay.data.bild_untertitel && <figcaption>{essay.data.bild_untertitel}</figcaption>}
      </figure>
    )}
    <header class="kopf">
      <p class="meta">
        {datum}
        {feld && (
          <>
            <span aria-hidden="true"> · </span>
            <span>{feld.name}</span>
          </>
        )}
        <span aria-hidden="true"> · </span>
        <span>{lesezeit} Min. Lesezeit</span>
      </p>
      <h1>{essay.data.title}</h1>
    </header>
    <Content />
    <p class="schluss" aria-hidden="true">⁂</p>
    {essay.data.substack_url && (
      <p class="substack">
        <a href={essay.data.substack_url} target="_blank" rel="noopener noreferrer">
          auch auf Substack ↗
        </a>
      </p>
    )}
  </article>
  {essay.data.bild && (
    <svg class="duotone-defs" width="0" height="0" aria-hidden="true" focusable="false">
      <defs>
        <!-- Tinte-auf-Papier: Schatten → dunkles Oliv-Tinte, Lichter → Papierton -->
        <filter id="annotanda-duotone" color-interpolation-filters="sRGB">
          <feColorMatrix type="saturate" values="0" />
          <feComponentTransfer>
            <feFuncR type="table" tableValues="0.125 0.925" />
            <feFuncG type="table" tableValues="0.141 0.894" />
            <feFuncB type="table" tableValues="0.102 0.827" />
          </feComponentTransfer>
        </filter>
        <!-- Dunkelmodus: Schatten → fast schwarz, Lichter → warmes Elfenbein -->
        <filter id="annotanda-duotone-dunkel" color-interpolation-filters="sRGB">
          <feColorMatrix type="saturate" values="0" />
          <feComponentTransfer>
            <feFuncR type="table" tableValues="0.078 0.902" />
            <feFuncG type="table" tableValues="0.078 0.875" />
            <feFuncB type="table" tableValues="0.063 0.816" />
          </feComponentTransfer>
        </filter>
      </defs>
    </svg>
  )}
</Basis>

<style>
  /* Nur im Reader Mode (mobile) sichtbar — Rücknavigation ohne globalen Header */
  .zurueck {
    display: none;
    font-family: var(--schrift-ui);
    font-size: 0.85rem;
    color: var(--grau);
    text-decoration: none;
    margin-bottom: 2rem;
    transition: transform 0.35s var(--feder), color 0.15s ease;
  }

  .zurueck:hover {
    color: var(--ink);
    transform: translateX(-5px);
  }

  @media (max-width: 640px) {
    .zurueck {
      display: block;
    }
  }

  article {
    animation: einblenden 0.5s ease-out both;
  }

  /* Getöntes Kopfbild — bewusste Ausnahme von der bildlosen Optik.
     Duotone-Filter (Tinte/Oliv auf Papier) bindet das Foto in die Farbwelt ein;
     der Filter wird pro Farbschema getauscht (siehe SVG-defs am Seitenende). */
  .kopfbild {
    margin: 0 0 2.5rem;
  }

  .kopfbild img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 360px;
    object-fit: cover;
    object-position: center 45%;
    border: 1px solid var(--linie);
    filter: url(#annotanda-duotone);
  }

  :global(html[data-farbschema='dunkel']) .kopfbild img {
    filter: url(#annotanda-duotone-dunkel);
  }

  .kopfbild figcaption {
    margin-top: 0.5rem;
    font-family: var(--schrift-ui);
    font-size: 0.8rem;
    font-style: italic;
    color: var(--grau);
  }

  .duotone-defs {
    position: absolute;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .kopf {
    margin-bottom: 2rem;
  }

  .kopf h1 {
    animation: aufklaren 0.7s ease-out 80ms both;
  }

  .meta {
    font-family: var(--schrift-ui);
    font-size: 0.85rem;
    color: var(--grau);
    margin: 0 0 0.5rem;
    letter-spacing: 0.02em;
    animation: einblenden 0.5s ease-out 250ms both;
  }

  .meta a {
    color: var(--grau);
    text-decoration: underline;
    text-decoration-color: var(--linie);
  }

  .meta a:hover {
    color: var(--ink);
  }

  article :global(p) {
    margin: 0 0 1rem;
  }

  article :global(blockquote) {
    border-left: 2px solid var(--akzent);
    margin: 1.5rem 0;
    padding: 0.25rem 0 0.25rem 1rem;
    color: var(--grau);
    font-style: italic;
  }

  article :global(em) {
    font-style: italic;
  }

  /* Asterismus als Schlusszeichen — klassische Druckertradition */
  .schluss {
    text-align: center;
    color: var(--akzent);
    font-size: 1.2rem;
    margin: 3rem 0 0;
    user-select: none;
  }

  /* Substack-Hinweis unter dem Asterismus — dieselbe Sprache wie in der
     Essay-Liste, nur zentriert unter dem Schlusszeichen. */
  .substack {
    text-align: center;
    margin: 1.25rem 0 0;
    font-family: var(--schrift-ui);
    font-size: 0.85rem;
  }

  .substack a {
    color: var(--grau);
    text-decoration: none;
    border-bottom: 1px solid var(--linie);
    padding-bottom: 1px;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .substack a:hover {
    color: var(--akzent);
    border-color: var(--akzent);
  }

  .fortschritt {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--akzent);
    box-shadow: 0 0 6px var(--akzent);
    transform: scaleX(0);
    transform-origin: left;
    z-index: 10;
  }
</style>

<script>
  // Skaliert den Balken proportional zur Scroll-Position — passiv, kein Layout-Thrashing
  const balken = document.querySelector('.fortschritt') as HTMLElement | null;
  if (balken) {
    const zeichne = () => {
      const html = document.documentElement;
      const max = html.scrollHeight - html.clientHeight;
      balken.style.transform = `scaleX(${max > 0 ? html.scrollTop / max : 0})`;
    };
    addEventListener('scroll', zeichne, { passive: true });
    zeichne();
  }
</script>
