---
import Basis from '../../layouts/Basis.astro';
import { argumente } from '../../data/argumente.js';
import { zerlegeDiagramm, textVon } from '../../lib/argument.ts';

export function getStaticPaths() {
  return argumente.map((a) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;
const eintrag = argumente.find((a) => a.slug === slug);

// Textfassung des Diagramms — steht immer im HTML, damit die Argumentation
// auch ohne JavaScript und für Crawler und Screenreader lesbar ist.
const knoten = zerlegeDiagramm(eintrag.diagramm);
const nummer = new Map(knoten.map((k, i) => [k.id, i + 1]));

// Kurzform für Querverweise: der Teil vor dem ersten Doppelpunkt/Gedankenstrich
// („Nagel, Torte vs. Pfirsich: War die Wahl je offen …" → „Nagel, Torte vs. Pfirsich")
const kurz = (id: string) => {
  const text = textVon(knoten, id).split(/[:—]/)[0].trim();
  return text.length > 48 ? text.slice(0, 48).replace(/\s+\S*$/, '') + ' …' : text;
};

const verweis = (ids: string[]) =>
  ids.map((id) => `Nr. ${nummer.get(id)} — ${kurz(id)}`).join('; ');
---

<Basis
  titel={`Argumente: ${eintrag.titel} — annotanda`}
  beschreibung={`Argumentationsstruktur des Essays „${eintrag.titel}"`}
>
  <p class="zurueck"><a href="/argumente/">← Alle Argument-Karten</a></p>

  <h1>{eintrag.titel}</h1>
  <p class="hinweis">Argumentationsstruktur des Essays</p>

  <div class="diagramm-wrapper">
    <pre class="mermaid">{eintrag.diagramm.trim()}</pre>
  </div>

  <!-- Textfassung: ohne JavaScript aufgeklappt und die einzige Darstellung,
       mit gezeichnetem Diagramm zugeklappt. Immer im HTML — das ist der Teil,
       den Crawler und Screenreader lesen. -->
  <details class="struktur" open>
    <summary>Argumentation als Text</summary>
    <ol>
      {knoten.map((k) => (
        <li>
          <span class="k-text">{k.text}</span>
          {k.stuetzt.length > 0 && (
            <span class="k-kante">stützt {verweis(k.stuetzt)}</span>
          )}
          {k.einwand.length > 0 && (
            <span class="k-kante einwand">Einwand gegen {verweis(k.einwand)}</span>
          )}
        </li>
      ))}
    </ol>
  </details>

  <p class="essay-link">
    <a href={`/essays/${eintrag.slug}/`}>Essay lesen →</a>
  </p>
</Basis>

<!-- Mermaid von CDN, kein npm install. is:inline hält den CDN-Import von Vite
     fern; gezeichnet wird über astro:page-load — sonst läuft das Skript bei
     View-Transition-Navigation nicht und das Diagramm bliebe leer. -->
<script is:inline type="module">
  import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';

  function zeichneMermaid() {
    const knoten = document.querySelectorAll('.mermaid');
    if (!knoten.length) return;

    // Farben aus den CSS-Variablen lesen, damit das Diagramm im Dark Mode lesbar bleibt
    const stil = getComputedStyle(document.documentElement);
    mermaid.initialize({
      startOnLoad: false,
      theme: 'base',
      themeVariables: {
        background: stil.getPropertyValue('--paper').trim(),
        primaryColor: stil.getPropertyValue('--paper').trim(),
        primaryBorderColor: stil.getPropertyValue('--akzent').trim(),
        primaryTextColor: stil.getPropertyValue('--ink').trim(),
        lineColor: stil.getPropertyValue('--akzent').trim(),
        edgeLabelBackground: stil.getPropertyValue('--paper').trim(),
        fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif',
        fontSize: '14px',
      },
    });

    // Quelltext sichern und zurücksetzen, damit auch ein erneutes Zeichnen
    // (z. B. nach Farbschema-Wechsel) sauber neu rendert
    knoten.forEach((n) => {
      if (!n.dataset.quelle) n.dataset.quelle = n.textContent;
      n.removeAttribute('data-processed');
      n.innerHTML = n.dataset.quelle;
    });

    // Erst nach erfolgreichem Zeichnen wird das Diagramm sichtbar und die
    // Textfassung zugeklappt. Scheitert Mermaid (CDN blockiert, Syntaxfehler),
    // bleibt der Quelltext verborgen und die Textfassung offen — dann steht
    // dort immer noch die vollständige Argumentation.
    mermaid.run({ nodes: Array.from(knoten) }).then(() => {
      document.querySelectorAll('.diagramm-wrapper').forEach((w) => {
        w.classList.add('gezeichnet');
      });
      document.querySelectorAll('details.struktur').forEach((d) => {
        d.open = false;
      });
    });
  }

  // Erstes Laden direkt ...
  zeichneMermaid();

  // ... und bei jeder weiteren Navigation neu zeichnen. Die Listener nur einmal
  // binden — document überlebt die ClientRouter-Seitenwechsel.
  if (!window.__mermaidGebunden) {
    window.__mermaidGebunden = true;
    document.addEventListener('astro:page-load', zeichneMermaid);
    // Farbschema-Wechsel: mit neuen Farben neu zeichnen, ohne Reload
    document.addEventListener('click', (e) => {
      if (e.target.closest('.schema-knopf')) setTimeout(zeichneMermaid, 180);
    });
  }
</script>

<style>
  .zurueck {
    font-family: var(--schrift-ui);
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }

  .hinweis {
    font-family: var(--schrift-ui);
    font-size: 0.9rem;
    color: var(--ink-soft);
    margin-top: -0.5rem;
  }

  /* Vor dem Zeichnen weggeklappt statt display:none — Mermaid muss die
     Textbreiten messen können, das geht nur bei vorhandenem Layout. */
  .diagramm-wrapper {
    max-height: 0;
    overflow: hidden;
  }

  .diagramm-wrapper.gezeichnet {
    max-height: none;
    margin: 2rem 0;
    overflow-x: auto;
  }

  .mermaid {
    background: transparent;
    font-family: var(--schrift-ui);
  }

  /* Textfassung des Diagramms */
  .struktur {
    margin: 2rem 0;
  }

  .struktur summary {
    font-family: var(--schrift-ui);
    font-size: 0.85rem;
    color: var(--grau);
    cursor: pointer;
  }

  .struktur summary:hover {
    color: var(--akzent);
  }

  .struktur ol {
    margin: 1rem 0 0;
    padding-left: 1.6rem;
  }

  .struktur li {
    margin-bottom: 0.9rem;
    line-height: 1.5;
  }

  .k-text {
    display: block;
  }

  .k-kante {
    display: block;
    font-family: var(--schrift-ui);
    font-size: 0.78rem;
    color: var(--grau);
    margin-top: 0.15rem;
  }

  .k-kante.einwand {
    font-style: italic;
  }

  .essay-link {
    margin-top: 2rem;
    font-family: var(--schrift-ui);
    font-size: 0.95rem;
  }
</style>
