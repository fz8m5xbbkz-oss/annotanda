---
import Basis from '../layouts/Basis.astro';
import SokratesRelief from '../components/SokratesRelief.astro';
import Statistik from '../components/Statistik.astro';
import { Content } from '../inhalte/ueber.md';
---

<Basis
  titel="Über — annotanda"
  beschreibung="Wer hinter annotanda steht und warum hier Philosophie und Verwaltungspraxis zusammen gelesen werden."
>
  <SokratesRelief />
  <div class="inhalt">
    <Content />
  </div>
  <Statistik />
</Basis>

<style>
  .inhalt {
    animation: aufklaren 0.6s ease-out both;
  }

  /* Erste Überschrift (Seitentitel) etwas vom Bild abrücken */
  .inhalt :global(h1) {
    margin-top: 0;
  }
</style>
