---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Randschmuck from '../components/Randschmuck.astro';
import Streiflicht from '../components/Streiflicht.astro';
import Hintergrund from '../components/Hintergrund.astro';
import { ClientRouter } from 'astro:transitions';
// Vercel Web Analytics (seit 27.07.2026): cookiefrei, keine IP-Speicherung,
// keine Wiedererkennung über Aufrufe hinweg. Bewusste Abkehr von „gar kein
// Zähler" — ohne Zahlen war nicht zu sagen, welcher Essay zieht. Muss im
// Vercel-Projekt unter Analytics aktiviert sein, sonst läuft es ins Leere.
import Analytics from '@vercel/analytics/astro';
import '../styles/global.css';

const {
  titel = 'annotanda',
  beschreibung = 'Philosophie aus dem Inneren der Verwaltung. Ein wöchentliches Denktagebuch von Luis.',
  karte = '/og/annotanda.png',
  leserModus = false,
  // Einzelne Texte sind `article`, Übersichten und Verzeichnisse `website`.
  // Daran unterscheiden Google und die Vorschau-Robots einen Artikel von einer
  // Listenseite — vorher war alles `website`.
  veroeffentlicht,
  rubrik,
} = Astro.props;

const istArtikel = Boolean(veroeffentlicht);

const kanonisch = new URL(Astro.url.pathname, Astro.site).toString();
// Social-Cards liegen als fertige PNGs in public/og/ (siehe karten.mjs).
// Absolute URL ist Pflicht — relative Pfade ignorieren die meisten Crawler.
const karteAbsolut = new URL(karte, Astro.site).toString();
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline>
      // Muss vor dem ersten Paint laufen, sonst flackert die Seite beim Laden hell auf
      (function () {
        var gespeichert = localStorage.getItem('farbschema');
        var dunkel = gespeichert
          ? gespeichert === 'dunkel'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        if (dunkel) document.documentElement.dataset.farbschema = 'dunkel';
        document.documentElement.classList.add('js');
      })();
    </script>
    <meta name="description" content={beschreibung} />
    <meta name="google-site-verification" content="obr4TfpPoqxxoENkMkBbSC6NvdY7PJ75ZJf47q4Guaw" />
    <link rel="canonical" href={kanonisch} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="annotanda" href="/rss.xml" />

    <!-- OpenGraph -->
    <meta property="og:type" content={istArtikel ? 'article' : 'website'} />
    {istArtikel && (
      <>
        <meta property="article:published_time" content={new Date(veroeffentlicht).toISOString()} />
        <meta property="article:author" content="Luis" />
        {rubrik && <meta property="article:section" content={rubrik} />}
      </>
    )}
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:url" content={kanonisch} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="annotanda" />
    <meta property="og:image" content={karteAbsolut} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${titel} — annotanda`} />

    <!-- Twitter / Bluesky-Vorschau -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titel} />
    <meta name="twitter:description" content={beschreibung} />
    <meta name="twitter:image" content={karteAbsolut} />

    <title>{titel}</title>

    <!-- Seitenübergänge: Astro Client Router (View Transitions) -->
    <ClientRouter />
  </head>
  <body class:list={[{ 'reader-modus': leserModus }]}>
    <!-- Tinte-Cursor: kleiner olivgrüner Nachzug-Punkt auf Desktop.
         transition:persist hält denselben Knoten über Seitenwechsel hinweg,
         sonst friert der Cursor nach dem Navigieren ein. -->
    <div class="tinte-cursor" aria-hidden="true" transition:persist></div>
    <Hintergrund />
    <Streiflicht />
    <Randschmuck />

    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <Analytics />

    <script>
      // ── Farbschema nach Seitenwechsel neu setzen ───────────────────────────
      // ClientRouter ersetzt beim Swap die <html>-Attribute durch die der
      // statischen Seite — data-farbschema und die js-Klasse gehen sonst verloren,
      // der Dark Mode würde bei jeder Navigation auf hell zurückspringen.
      function setzeFarbschema() {
        const gespeichert = localStorage.getItem('farbschema');
        const dunkel = gespeichert
          ? gespeichert === 'dunkel'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        if (dunkel) document.documentElement.dataset.farbschema = 'dunkel';
        else delete document.documentElement.dataset.farbschema;
        document.documentElement.classList.add('js');
      }

      // ── Scroll-Reveal ──────────────────────────────────────────────────────
      function initReveal() {
        const versteckte = document.querySelectorAll('[data-reveal]');
        const ruhig = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!ruhig && 'IntersectionObserver' in window) {
          const beobachter = new IntersectionObserver(
            (eintraege) => {
              for (const eintrag of eintraege) {
                if (eintrag.isIntersecting) {
                  eintrag.target.classList.add('sichtbar');
                  beobachter.unobserve(eintrag.target);
                }
              }
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.1 }
          );
          versteckte.forEach((el) => beobachter.observe(el));
        } else {
          versteckte.forEach((el) => el.classList.add('sichtbar'));
        }
      }

      // ── Tinte-Cursor ───────────────────────────────────────────────────────
      // Nachzug-Effekt: der Punkt folgt dem Cursor mit leichtem Verzug (Lerp)
      function initCursor() {
        const ruhig = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const touch = matchMedia('(hover: none)').matches;
        if (ruhig || touch) return;

        const cursor = document.querySelector('.tinte-cursor') as HTMLElement | null;
        if (!cursor) return;

        let mx = -100, my = -100, cx = -100, cy = -100;
        let sichtbar = false;

        document.addEventListener('mousemove', (e) => {
          mx = e.clientX;
          my = e.clientY;
          if (!sichtbar) {
            cursor.style.opacity = '1';
            sichtbar = true;
          }
        }, { passive: true });

        document.addEventListener('mouseleave', () => {
          cursor.style.opacity = '0';
          sichtbar = false;
        });

        // Interaktive Elemente: Cursor vergrößert sich leicht
        document.addEventListener('mouseover', (e) => {
          const ziel = (e.target as Element).closest('a, button');
          if (ziel) cursor.classList.add('aktiv');
        });
        document.addEventListener('mouseout', (e) => {
          const ziel = (e.target as Element).closest('a, button');
          if (ziel) cursor.classList.remove('aktiv');
        });

        const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
        const tick = () => {
          cx = lerp(cx, mx, 0.12);
          cy = lerp(cy, my, 0.12);
          cursor.style.transform = `translate(${cx}px, ${cy}px)`;
          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }

      // ── Magnetische Buttons ────────────────────────────────────────────────
      // Footer-Knöpfe ziehen leicht zum Mauszeiger hin
      function initMagnet() {
        const ruhig = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const touch = matchMedia('(hover: none)').matches;
        if (ruhig || touch) return;

        document.querySelectorAll<HTMLElement>('.knopf').forEach((knopf) => {
          knopf.addEventListener('mousemove', (e) => {
            const r = knopf.getBoundingClientRect();
            const dx = e.clientX - (r.left + r.width / 2);
            const dy = e.clientY - (r.top + r.height / 2);
            knopf.style.transform = `translate(${dx * 0.25}px, ${dy * 0.25 - 3}px) rotate(-1deg)`;
            knopf.style.boxShadow = `${dx * -0.05}px 3px 0 var(--akzent)`;
          });
          knopf.addEventListener('mouseleave', () => {
            knopf.style.transform = '';
            knopf.style.boxShadow = '';
          });
        });
      }

      // Erstes Laden
      initReveal();
      initCursor();
      initMagnet();

      // Nach jedem Seitenwechsel: Theme zurücksetzen (vor dem Paint) und die
      // an getauschte Elemente gebundenen Effekte neu initialisieren.
      // Der Cursor persistiert (transition:persist) und bleibt aktiv.
      document.addEventListener('astro:after-swap', () => {
        setzeFarbschema();
        initReveal();
        initMagnet();
      });
    </script>
  </body>
</html>

<style is:global>
  /* ── Seitenübergang: Blatt auf den Tisch legen (Konzept 1d) ──
     Das neue <main> kippt leicht herein und legt sich auf den Tisch —
     die physische Fortsetzung von `aufklaren`. Das alte Blatt verschwindet
     ohne eigene Animation darunter (kein Crossfade). */
  @keyframes blatt-auflegen {
    from {
      opacity: 0;
      transform: perspective(1000px) rotateX(-10deg) translateY(24px);
      filter: blur(5px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }

  ::view-transition-old(blatt) {
    animation: none;
    opacity: 0;
  }
  ::view-transition-new(blatt) {
    animation: blatt-auflegen 0.65s var(--feder) both;
    transform-origin: 50% 100%;
  }

  /* Den Seitenübergang nur auf den main-Bereich anwenden */
  main {
    view-transition-name: blatt;
  }

  /* Beim Dark-Mode-Wipe darf main NICHT als eigene Ebene mitlaufen — sonst
     springt der Inhalt sofort ins neue Schema statt vom Kreis erfasst zu werden.
     (Die root-Regel mit animation:none steht bereits in global.css.) */
  html.schema-wechsel main {
    view-transition-name: none;
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(blatt),
    ::view-transition-new(blatt) {
      animation: none;
    }
  }

  /* ── Tinte-Cursor ──────────────────────────────────────────── */
  .tinte-cursor {
    pointer-events: none;
    position: fixed;
    top: -6px;
    left: -6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--akzent);
    opacity: 0;
    z-index: 9999;
    will-change: transform;
    transition:
      opacity 0.3s ease,
      width 0.25s var(--feder),
      height 0.25s var(--feder),
      top 0.25s var(--feder),
      left 0.25s var(--feder),
      background 0.2s ease;
    mix-blend-mode: multiply;
  }

  html[data-farbschema='dunkel'] .tinte-cursor {
    mix-blend-mode: screen;
  }

  .tinte-cursor.aktiv {
    width: 24px;
    height: 24px;
    top: -12px;
    left: -12px;
    background: var(--akzent);
    opacity: 0.5;
  }

  @media (hover: none) {
    .tinte-cursor { display: none; }
  }
</style>
